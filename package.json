{
  "name": "datetime",
  "displayName": "DateTime",
  "description": "Extension for those who like keep their OS toolbar hidden by default.",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.85.0"
  },
  "author": {
    "name": "Andres Rosales"
  },
  "publisher": "Andresaerg",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andresaerg/DateTime.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "DateTime Configuration",
      "properties": {
        "datetime.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable this extension"
        },
        "datetime.showDate": {
          "type": "boolean",
          "default": false,
          "description": "Show the date in the status bar"
        },
        "datetime.militaryTime": {
          "type": "boolean",
          "default": false,
          "description": "Show the time in military time"
        },
        "datetime.customTimeFormat": {
          "type": "string",
          "default": "",
          "description": "Custom time format (e.g., 'HH:mm:ss', 'h:mm a'). Leave empty to use system default. Only applies when military time is disabled."
        },
        "datetime.showInternetConnectionStatus": {
          "type": "boolean",
          "default": false,
          "description": "Show the internet connection status in the status bar"
        }
      }
    },
    "commands": [
      {
        "command": "datetime.openMenu",
        "title": "Open Menu"
      },
      {
        "command": "datetime.toggleEnable",
        "title": "Toggle Enable"
      },
      {
        "command": "datetime.toggleShowDate",
        "title": "Toggle Show Date"
      },
      {
        "command": "datetime.toggleMilitaryTime",
        "title": "Toggle Military Time"
      },
      {
        "command": "datetime.toggleCustomFormat",
        "title": "Toggle Custom Format"
      },
      {
        "command": "datetime.toggleInternetConnectionStatus",
        "title": "Toggle Internet Connection Status"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}